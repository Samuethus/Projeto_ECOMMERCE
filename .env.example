# Copie este arquivo para `.env` e preencha com os SEUS valores.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
# Depois rode:  python scripts/gerar_config.py

# Supabase > Project Settings > API
# Use SOMENTE a chave "anon/publishable". NUNCA a "service_role"/"secret".
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SUA-CHAVE

# Cloudflare Workers AI (fundo da Produção) — usados só para testes locais;
# na função, cadastre em Supabase → Edge Functions → Secrets.
# Account ID = só o código de 32 caracteres (não a URL do painel).
CLOUDFLARE_ACCOUNT_ID=seu_account_id
CLOUDFLARE_API_TOKEN=seu_token
